<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<connectionStrings>
		<!-- Local SQL Server (LocalDB) that ships with Visual Studio. Build it with setup-db.cmd in the repo root. -->
		<add name="MeowletDb"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=MeowletEducation;Integrated Security=True;Connect Timeout=30"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<!-- 100 MB: lesson videos can be uploaded from the course builder. -->
		<httpRuntime targetFramework="4.7.2" maxRequestLength="102400" executionTimeout="300" />
	</system.web>

	<system.webServer>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="104857600" />
			</requestFiltering>
		</security>
		<staticContent>
			<remove fileExtension=".webp" />
			<mimeMap fileExtension=".webp" mimeType="image/webp" />
		</staticContent>
	</system.webServer>
</configuration>